<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace></RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Gone.vb;Old\**" />
    <Compile Remove="Quoted.vb" Condition='false' />
    <Compile Remove='Solo.vb' />
    <Compile Remove="Shallow\*.vb" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Compile Remove="Maybe.vb" />
  </ItemGroup>
</Project>
